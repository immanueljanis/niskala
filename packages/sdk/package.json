{
  "name": "@niskala/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Niskala Markets: sealed RFQ rounds on Monad with ZK-verified best execution. Trader, reader, maker and prover surfaces over Web3.js.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/immanueljanis/niskala.git",
    "directory": "packages/sdk"
  },
  "keywords": ["monad", "rfq", "zero-knowledge", "noir", "web3", "sealed-bid"],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./maker": "./src/maker.ts",
    "./prover": "./src/prover.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "./maker": { "types": "./dist/maker.d.ts", "default": "./dist/maker.js" },
      "./prover": { "types": "./dist/prover.d.ts", "default": "./dist/prover.js" }
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "gen": "tsx scripts/gen.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "example:trader": "node --env-file=.env --import tsx examples/trader.ts",
    "example:maker": "node --env-file=.env --import tsx examples/maker.ts"
  },
  "peerDependencies": {
    "@aztec/bb.js": "5.2.1",
    "@niskala/zk": "workspace:*",
    "web3": "^4.16.0"
  },
  "peerDependenciesMeta": {
    "@aztec/bb.js": { "optional": true },
    "@niskala/zk": { "optional": true }
  },
  "devDependencies": {
    "@aztec/bb.js": "5.2.1",
    "@niskala/zk": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "web3": "^4.16.0"
  }
}
