# Monad testnet (official: https://docs.monad.xyz/developer-essentials/testnets). Contract addresses come from
# packages/pools/pools.json through @niskala/sdk; nothing else is needed for reads.
NEXT_PUBLIC_CHAIN_ID=10143
# Browser reads default to Ankr so they never compete with the coordinator for the official RPC's 15 rps.
NEXT_PUBLIC_RPC_URL=https://rpc.ankr.com/monad_testnet
NEXT_PUBLIC_EXPLORER_URL=https://testnet.monadvision.com

# Coordinator REST API (apps/coordinator); on Vercel point this at the Railway domain.
NEXT_PUBLIC_COORDINATOR_URL=http://localhost:8787
