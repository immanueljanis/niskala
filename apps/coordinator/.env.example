# Monad testnet (official: https://docs.monad.xyz/developer-essentials/testnets)
RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143
EXPLORER_TX_BASE=https://testnet.monadvision.com/tx/

# Contract addresses come from packages/pools/pools.json (written by `pnpm deploy:pools`).

# Up to five demo market-maker wallets (registered in every market's roster at deploy time)
MM_A_KEY=0x
MM_B_KEY=0x
MM_C_KEY=0x
MM_D_KEY=0x
MM_E_KEY=0x

# Submits proof transactions and deadline housekeeping (needs MON: one proof ≈ 0.65 MON at 102 gwei)
RELAYER_KEY=0x

# Only needed by `pnpm setup` (funds wallets, deposits maker collateral per pool, mints trader USDC)
DEPLOYER_KEY=0x
TRADER_ADDRESS=
# RELAYER_TOPUP=6
# MIN_RELAYER_GAS=3

# Fallback mid price when the public price feed is unreachable (USDC per base unit, 6 decimals)
REFERENCE_PRICE_E6=3500000000
PORT=8787
POLL_MS=1500

# Envio HyperSync (https://envio.dev/app/api-tokens): full round history across all markets without eth_getLogs limits.
# Empty disables it; the coordinator then falls back to 100-block log scans for transaction hashes.
ENVIO_API_TOKEN=
# HISTORY_FROM_BLOCK=70500000
