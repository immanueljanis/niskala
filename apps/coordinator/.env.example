# Monad testnet (official: https://docs.monad.xyz/developer-essentials/testnets)
RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143
EXPLORER_TX_BASE=https://testnet.monadvision.com/tx/

# From contracts/deployments/10143.json
MARKET_ADDRESS=0x
USDC_ADDRESS=0x
WETH_ADDRESS=0x

# Three independent market-maker wallets (registered in the market roster at deploy time)
MM_A_KEY=0x
MM_B_KEY=0x
MM_C_KEY=0x

# Submits proof transactions (permissionless; needs MON for gas)
RELAYER_KEY=0x

# Only needed by `pnpm setup` (funds wallets, deposits MM WETH, mints trader USDC)
DEPLOYER_KEY=0x
TRADER_ADDRESS=

# Fallback mid price (USDC per WETH, 6 decimals) when the public price feed is unreachable
REFERENCE_PRICE_E6=3500000000
PORT=8787
POLL_MS=1500
